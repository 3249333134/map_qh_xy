.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  background-color: #ffffff;
  border-top: 1px solid #eef2f7;
  box-shadow: 0 -4px 18px rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
  padding-bottom: 0;
  height: 64px;
}

.tabbar-item {
  flex: 1;
  height: 56px;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.icon {
  width: 24px;
  height: 24px;
}

.label {
  font-size: 12px;
  color: #94a3b8;
}

.active .label {
  color: #ea580c;
  font-weight: 600;
}

/* 中间发布按钮为正圆 */
.publish-item { position: relative; z-index: 10; }
.publish-item .label { display: none; }

.plus-wrapper {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  transform: translateY(-15px);
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  border: 3px solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(255, 71, 87, 0.3),
              0 2px 8px rgba(255, 107, 53, 0.2),
              0 0 20px rgba(247, 147, 30, 0.1),
              0 8px 32px rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

.plus-sign { color: #fff; font-size: 32px; line-height: 1; }

@media screen and (max-width: 375px) {
  .plus-wrapper { width: 55px; height: 55px; transform: translateY(-12px); }
  .plus-sign { font-size: 28px; }
}

@media screen and (min-width: 414px) {
  .plus-wrapper { width: 65px; height: 65px; transform: translateY(-18px); }
  .plus-sign { font-size: 36px; }
}

/* Visual system overrides: keep native custom-tab-bar aligned with the Vue version. */
.tabbar {
  height: 66px;
  background-color: rgba(255, 255, 255, 0.96);
  border-top-color: rgba(226, 232, 240, 0.82);
  box-shadow: 0 -8px 28px rgba(15, 23, 42, 0.08);
}

.tabbar-item {
  min-width: 44px;
  min-height: 44px;
}

.label {
  margin-top: 2px;
  color: #64748b;
}

.plus-wrapper {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  box-shadow: 0 8px 24px rgba(234, 88, 12, 0.28);
}
.publish-item {
  position: relative;
  z-index: 10;
}
.publish-item .label { display: none; }

.plus-wrapper {
  width: 60px;
  height: 60px;
  aspect-ratio: 1 / 1;                       /* 保证正圆 */
  border-radius: 50%;
  clip-path: circle(50% at 50% 50%);         /* 强制圆形裁剪 */
  transform: translateY(-15px);
  background: radial-gradient(circle at 50% 40%, #ff8a3d 0%, #ff6b35 60%, #ff4757 100%);
  border: 3px solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(255, 71, 87, 0.3),
              0 2px 8px rgba(255, 107, 53, 0.2),
              0 0 20px rgba(247, 147, 30, 0.1),
              0 8px 32px rgba(0, 0, 0, 0.1);
}

.plus-sign { color: #fff; font-size: 32px; line-height: 1; }

@media screen and (max-width: 375px) {
  .plus-wrapper { width: 55px; height: 55px; transform: translateY(-12px); }
  .plus-sign { font-size: 28px; }
}

@media screen and (min-width: 414px) {
  .plus-wrapper { width: 65px; height: 65px; transform: translateY(-18px); }
  .plus-sign { font-size: 36px; }
}
