.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  height: 48px;
  padding-bottom: 10px;
  overflow: visible;
  box-sizing: content-box;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #e2e8f0;
  box-shadow: 0 -8px 24px rgba(15, 23, 42, 0.07);
}

.tabbar-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  height: 48px;
  overflow: visible;
  text-align: center;
}

.icon {
  width: 23px;
  height: 23px;
}

.label {
  margin-top: 0;
  color: #64748b;
  font-size: 11px;
}

.active .label {
  color: #ea580c;
  font-weight: 600;
}

.publish-item {
  z-index: 20;
  overflow: visible;
}

.publish-item .label {
  display: none;
}

.tabbar .publish-item .plus-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  overflow: hidden;
  box-sizing: border-box;
  transform: translateY(-14px);
  border: 4px solid #ffffff;
  border-radius: 50%;
  background-color: #ea580c;
  box-shadow: 0 10px 26px rgba(234, 88, 12, 0.38);
  opacity: 1;
  visibility: visible;
}

.tabbar .publish-item .plus-wrapper.open {
  background-color: #c2410c;
  box-shadow: 0 10px 26px rgba(194, 65, 12, 0.42);
}

.tabbar .publish-item .plus-sign {
  color: #ffffff;
  font-size: 36px;
  font-weight: 300;
  line-height: 1;
}

.tabbar .publish-item .plus-wrapper.open .plus-sign {
  transform: rotate(45deg);
}

.publish-item:active .plus-wrapper {
  opacity: 0.86;
}

@media screen and (max-width: 375px) {
  .tabbar .publish-item .plus-wrapper {
    width: 56px;
    height: 56px;
    transform: translateY(-13px);
  }

  .tabbar .publish-item .plus-sign {
    font-size: 34px;
  }
}
