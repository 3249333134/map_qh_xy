.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  height: 48px;
  padding-bottom: 10px;
  overflow: visible;
  box-sizing: content-box;
 background: rgba(250,253,252,.92); border-top: 1px solid rgba(255,255,255,.95); border-radius: 24px 24px 0 0; box-shadow: 0 -8px 28px rgba(40,68,63,.10); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); }

.tabbar-item {
  position: relative;
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  height: 48px;
  overflow: visible;
  text-align: center;
}

.icon {
  width: 23px;
  height: 23px;
  filter: grayscale(1);
  opacity: 0.72;
}

.label {
  margin-top: 0;
  color: #595959;
  font-size: 11px;
}

.active .label {
  color: #202020;
  font-weight: 600;
}

.publish-item {
  z-index: 20;
  overflow: visible;
}

.publish-item .label {
  display: none;
}

.tabbar .publish-item .plus-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  overflow: hidden;
  box-sizing: border-box;
  transform: translateY(-14px);
  border: 4px solid #ffffff;
  border-radius: 50%;
  background-color: #f56f64;
  box-shadow: 0 4px 12px rgba(0,0,0,.10);
  opacity: 1;
  visibility: visible;
}

.tabbar .publish-item .plus-wrapper.open {
  background-color: #d9574f;
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.1);
}

.tabbar .publish-item .plus-sign {
  color: #ffffff;
  font-size: 30px;
  font-weight: 300;
  line-height: 1;
}

.tabbar .publish-item .plus-wrapper.open .plus-sign {
  transform: rotate(45deg);
}

.publish-item:active .plus-wrapper {
  opacity: 0.86;
}

@media screen and (max-width: 375px) {
  .tabbar .publish-item .plus-wrapper {
    width: 52px;
    height: 52px;
    transform: translateY(-13px);
    box-shadow: 0 4px 12px rgba(0,0,0,.10);
  }

  .tabbar .publish-item .plus-sign {
    font-size: 30px;
  }
}

.active .icon {
  filter: brightness(0);
  opacity: 0.88;
}

/* Release the parent stacking context so the original close button alone sits above the sheet. */
.tabbar.overlay-open { position:static; z-index:auto; background:transparent; border-color:transparent; box-shadow:none; backdrop-filter:none; -webkit-backdrop-filter:none; pointer-events:none; }
.tabbar.overlay-open::before { content:''; position:fixed; left:0; right:0; bottom:0; height:58px; z-index:8000; border-radius:24px 24px 0 0; background:rgba(250,253,252,.92); pointer-events:none; }
.tabbar.overlay-open .tabbar-item { z-index:8001; pointer-events:none; }
.tabbar.overlay-open .publish-item { z-index:10001; pointer-events:auto; }
